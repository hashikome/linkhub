{
  "name": "ntumie",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "bun run tooling/setup-git-hooks.ts",
    "dev": "bun tooling/dev.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "api:dev": "bun run infra:up && bun run --filter @ntumie/api start:dev",
    "api:start": "bun run --filter @ntumie/api start",
    "api:debug": "bun run --filter @ntumie/api start:debug",
    "api:prod": "bun run --filter @ntumie/api start:prod",
    "api:build": "bun run --filter @ntumie/api build",
    "api:test": "bun run --filter @ntumie/api test",
    "api:test:e2e": "bun run --filter @ntumie/api test:e2e",
    "types:typecheck": "bun run --filter @ntumie/types typecheck",
    "email:typecheck": "bun run --filter @ntumie/email typecheck",
    "email:test": "bun test packages/email",
    "build": "bun run api:build && bun run web:build",
    "check:boundaries": "bun tooling/check-client-boundaries.ts",
    "check:guide-pin": "bun tooling/check-guide-pin.ts",
    "verify:isolated": "bun tooling/verify-isolated.ts",
    "verify": "bun run check:boundaries && bun run check:telemetry && bun run check:docs && bun run check:guide-pin && bun run types:typecheck && bun run email:typecheck && bun run format:check && bun run lint && bun run tooling:test && bun run email:test && bun run --filter @ntumie/api verify && bun run check:web && bun run web:test && bun run web:build && bun run web:typecheck",
    "check": "biome check --write package.json biome.json apps packages tooling",
    "format": "biome format --write package.json biome.json apps packages tooling",
    "format:check": "biome format package.json biome.json apps packages tooling",
    "lint": "biome lint package.json biome.json apps packages tooling",
    "check:telemetry": "bun tooling/check-telemetry.ts",
    "verify:release-image": "bun tooling/verify-release-image.ts",
    "check:docs": "bun tooling/check-docs.ts",
    "tooling:test": "bun test ./tooling/check-docs.test.ts ./tooling/dev-config.test.ts ./tooling/verification-env.test.ts ./tooling/verification-snapshot.test.ts ./tooling/deployment-contract.test.ts ./tooling/release.test.ts",
    "web:dev": "bun run infra:up && bun run --filter @ntumie/web dev",
    "web:build": "bun run --filter @ntumie/web build",
    "web:typecheck": "bun run --filter @ntumie/web typecheck",
    "web:test": "bun run --filter @ntumie/web test",
    "check:web": "bun tooling/check-web-boundaries.ts",
    "test:browser": "bun tooling/verify-browser.ts",
    "test:dev": "bun tooling/verify-dev-loop.ts",
    "db:seed": "bun run --filter @ntumie/api db:seed",
    "test:browser:critical": "bun tooling/verify-browser.ts --test-name-pattern '\\[critical\\]'"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@playwright/test": "1.63.0"
  },
  "trustedDependencies": [
    "@prisma/engines",
    "prisma",
    "unrs-resolver"
  ]
}
