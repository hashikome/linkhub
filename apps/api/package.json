{
  "name": "@nslinkhub/api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "bun run postinstall && nest build",
    "verify": "bun run build && bun run typecheck && bun run test && bun run test:e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "prisma generate",
    "start": "bun src/entrypoint.ts",
    "start:dev": "bun --watch src/entrypoint.ts",
    "start:debug": "bun --inspect --watch src/entrypoint.ts",
    "start:prod": "bun --tsconfig-override tsconfig.runtime.json dist/src/entrypoint.js",
    "test": "bun ../../tooling/verify-api-tests.ts unit",
    "test:watch": "bun test --watch src",
    "test:cov": "bun test --coverage src",
    "test:e2e": "bun ../../tooling/verify-test-isolation.ts && bun ../../tooling/verify-api-tests.ts e2e",
    "email:worker": "bun src/email/worker.ts",
    "email:worker:dev": "bun --watch src/email/worker.ts",
    "email:worker:prod": "bun --tsconfig-override tsconfig.runtime.json dist/src/email/worker.js",
    "admin:recover": "bun src/operations/recover.ts",
    "admin:recover:prod": "bun --tsconfig-override tsconfig.runtime.json dist/src/operations/recover.js",
    "db:seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.6.23",
    "@logtape/logtape": "2.3.0",
    "@logtape/sentry": "2.3.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nslinkhub/config": "workspace:*",
    "@nslinkhub/email": "workspace:*",
    "@nslinkhub/types": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/bun": "10.69.0",
    "better-auth": "^1.6.23",
    "bullmq": "^5.20.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "docx": "^9.7.1",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "ioredis": "^5.4.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bun": "^1.3.14",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "prisma": "^7.8.0",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3"
  }
}
