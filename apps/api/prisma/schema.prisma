// Schema for the hub tenancy model (Hub → Collections → Resources).
// The migration SQL remains the source of truth for objects Prisma cannot
// model: the app_uuid_v7() function, set_updated_at triggers, the
// CHECK constraints and the partial unique
// index uq_resources_collection_link. Future migrations: use `prisma migrate
// dev --create-only` and review the SQL so those objects are never dropped.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  username               String    @unique @db.VarChar(20)
  selfDeactivated        Boolean   @default(false) @map("self_deactivated")
  name                   String    @db.VarChar(255)
  bio                    String?   @db.VarChar(500)
  email                  String    @unique @db.VarChar(255)
  emailVerified          Boolean   @default(false) @map("email_verified")
  image                  String?
  // Notification center: the badge counts items newer than seenAt; items at or
  // before clearedAt are hidden from the list.
  notificationsSeenAt    DateTime? @map("notifications_seen_at") @db.Timestamptz(6)
  notificationsClearedAt DateTime? @map("notifications_cleared_at") @db.Timestamptz(6)
  lastLoginAt            DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  accountState         String         @default("active") @map("account_state") @db.VarChar(16)
  operationsVersion    Int            @default(1) @map("operations_version")
  suspensionReason     String?        @map("suspension_reason") @db.VarChar(32)
  suspendedAt          DateTime?      @map("suspended_at") @db.Timestamptz(6)
  deletionScheduledFor DateTime?      @map("deletion_scheduled_for") @db.Timestamptz(6)
  operatorGrant        OperatorGrant?
  adminGrant           AdminGrant?

  hub                Hub?
  createdCollections Collection[]        @relation("CollectionCreator")
  shares             CollectionShare[]
  shareEntries       ShareEntry[]
  saves              CollectionSave[]
  sessions           Session[]
  accounts           Account[]
  comments           CollectionComment[] @relation("CommentAuthor")
  hiddenComments     CollectionComment[] @relation("CommentHider")
  addedResources     Resource[]          @relation("ResourceAddedBy")

  @@index([deletionScheduledFor])
  @@map("users")
}

model Hub {
  handleClaimedAt DateTime? @map("handle_claimed_at") @db.Timestamptz(6)
  showOwner   Boolean  @default(true) @map("show_owner")
  id          String   @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  ownerUserId String   @unique @map("owner_user_id") @db.Uuid
  handle      String   @unique @db.VarChar(60)
  name        String   @default("My hub") @db.VarChar(255)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner                    User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  collections              Collection[]
  firstCaptureCollectionId String?      @map("first_capture_collection_id") @db.Uuid
  firstCaptureCollection   Collection?  @relation("FirstCapture", fields: [firstCaptureCollectionId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("hubs")
}

model Collection {
  id                 String   @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  hubId              String   @map("hub_id") @db.Uuid
  slug               String   @db.VarChar(120)
  title              String   @db.VarChar(255)
  description        String?
  published          Boolean  @default(false)
  linkSharingEnabled Boolean  @default(false) @map("link_sharing_enabled")
  commentsEnabled    Boolean  @default(true) @map("comments_enabled")
  shareTokenHash     String?  @map("share_token_hash") @db.VarChar(255)
  creatorUserId      String?  @map("creator_user_id") @db.Uuid
  version            BigInt   @default(1)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  firstCaptureHubs Hub[]               @relation("FirstCapture")
  hold             CollectionHold?
  hub              Hub                 @relation(fields: [hubId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creator          User?               @relation("CollectionCreator", fields: [creatorUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  resources        Resource[]          @relation("CollectionResources")
  tags             CollectionTag[]
  linkedBy         Resource[]          @relation("ResourceLinkedCollection")
  shares           CollectionShare[]
  saves            CollectionSave[]
  comments         CollectionComment[]

  @@unique([hubId, slug], map: "collections_hub_slug_unique")
  @@index([published, updatedAt(sort: Desc)], map: "idx_collections_published_updated_at")
  @@map("collections")
}

// Shared normalized names; there is no public catalogue/usage endpoint.
model Tag {
  id          String @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  name        String @unique(map: "tags_name_unique") @db.VarChar(80)
  items       ItemTag[]
  collections CollectionTag[]

  @@map("tags")
}

model ItemTag {
  itemId   String @map("item_id") @db.Uuid
  tagId    String @map("tag_id") @db.Uuid
  position Int

  item Resource @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tag  Tag      @relation(fields: [tagId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([itemId, tagId])
  @@index([tagId], map: "idx_item_tags_tag_id")
  @@map("item_tags")
}

// Stored collection/tag union; item_count is maintained by database triggers.
model CollectionTag {
  collectionId String @map("collection_id") @db.Uuid
  tagId        String @map("tag_id") @db.Uuid
  itemCount    Int    @map("item_count")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([collectionId, tagId])
  @@index([tagId], map: "idx_collection_tags_tag_id")
  @@map("collection_tags")
}

// Collection collaborators: role is viewer or contributor (SQL CHECK).
model CollectionShare {
  collectionId String   @map("collection_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  role         String   @db.VarChar(16)
  source       String   @db.VarChar(16)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([collectionId, userId])
  @@index([userId], map: "idx_collection_shares_user_id")
  @@map("collection_shares")
}

model CollectionSave {
  collectionId String   @map("collection_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  savedAt      DateTime @default(now()) @map("saved_at") @db.Timestamptz(6)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([collectionId, userId])
  @@index([userId], map: "idx_collection_saves_user_id")
  @@map("collection_saves")
}

model Resource {
  id                 String   @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  collectionId       String   @map("collection_id") @db.Uuid
  kind               String   @db.VarChar(24)
  url                String?
  linkedCollectionId String?  @map("linked_collection_id") @db.Uuid
  titleOverride      String?  @map("title_override") @db.VarChar(255)
  sectionDescription String?  @map("section_description") @db.VarChar(500)
  // Who added the item (null for items saved before attribution, or once the
  // account is deleted); the activity entry stays the record.
  addedByUserId      String?  @map("added_by_user_id") @db.Uuid
  tags               ItemTag[]
  position           Int
  version            BigInt   @default(1)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  collection       Collection  @relation("CollectionResources", fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  linkedCollection Collection? @relation("ResourceLinkedCollection", fields: [linkedCollectionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  addedBy          User?       @relation("ResourceAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([collectionId, position], map: "resources_collection_position_unique")
  @@index([collectionId, updatedAt(sort: Desc)], map: "idx_resources_collection_updated_at")
  @@map("resources")
}

model Session {
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  id         String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  token      String    @unique
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  userId     String    @map("user_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_sessions_user_id")
  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_accounts_user_id")
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier], map: "idx_verifications_identifier")
  @@map("verifications")
}

// Atomic fixed-window budgets shared across API replicas. The key is a
// purpose-bound HMAC, never a raw source address or credential.
model RequestBudget {
  key       String   @id @db.VarChar(80)
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "idx_request_budgets_expires")
  @@map("request_budgets")
}

// Workflow binding only: better-auth Verification owns all proof material.
model EmailChangeIntent {
  userId       String   @id @map("user_id") @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  currentEmail String   @map("current_email")
  newEmail     String   @map("new_email")
  phase        String   @db.VarChar(16)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("email_change_intents")
}

model EmailOutbox {
  id           String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  challengeKey String    @map("challenge_key") @db.VarChar(64)
  recipientKey String    @map("recipient_key") @db.VarChar(64)
  payload      String?
  state        String    @default("pending") @db.VarChar(16)
  attempts     Int       @default(0)
  availableAt  DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  leaseUntil   DateTime? @map("lease_until") @db.Timestamptz(6)
  leaseToken   String?   @map("lease_token") @db.Uuid
  providerId   String?   @unique @map("provider_id")
  outcome      String?   @db.VarChar(24)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([state, availableAt])
  @@index([expiresAt])
  @@index([challengeKey])
  @@map("email_outbox")
}

model EmailWebhook {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("email_webhooks")
}

model EmailSuppression {
  recipientKey String   @id @map("recipient_key") @db.VarChar(64)
  reason       String   @db.VarChar(24)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("email_suppressions")
}

model OperatorGrant {
  userId    String   @id @map("user_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  authority String   @db.VarChar(128)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("operator_grants")
}

model CollectionHold {
  collectionId String     @id @map("collection_id") @db.Uuid
  active       Boolean    @default(true)
  reason       String     @db.VarChar(32)
  actorUserId  String     @map("actor_user_id") @db.Uuid
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  version      Int        @default(1)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("collection_holds")
}

model AdminGrant {
  userId       String   @id @map("user_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  invitationId String   @map("invitation_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("admin_grants")
}

model AdminBootstrap {
  id           Int       @id
  invitationId String    @map("invitation_id") @db.Uuid
  claimedById  String?   @map("claimed_by_id") @db.Uuid
  claimedAt    DateTime? @map("claimed_at") @db.Timestamptz(6)

  @@map("admin_bootstrap")
}

model ServiceInvitation {
  tokenHash     String?  @unique @map("token_hash") @db.VarChar(64)
  id            String   @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  role          String   @db.VarChar(16)
  email         String   @db.VarChar(254)
  inviteeUserId String?  @map("invitee_user_id") @db.Uuid
  invitedById   String?  @map("invited_by_id") @db.Uuid
  acceptedById  String?  @map("accepted_by_id") @db.Uuid
  state         String   @default("pending") @db.VarChar(16)
  version       Int      @default(1)
  deliveryId    String?  @map("delivery_id") @db.Uuid
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([email, state])
  @@index([invitedById, state])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("service_invitations")
}

// Retry receipts contain only immutable identifiers and an input digest. They
// survive content deletion so replay cannot silently recreate removed content.
// Metadata for one public web address, shared by every item that links to it.
// A pending row is also the durable lookup job (outbox shape, like email):
// written in the save's transaction, relayed and claimed by the worker.
model LinkMetadata {
  id          String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  url         String    @unique
  title       String?   @db.VarChar(255)
  description String?   @db.VarChar(500)
  siteName    String?   @map("site_name") @db.VarChar(120)
  state       String    @default("pending") @db.VarChar(16)
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  leaseUntil  DateTime? @map("lease_until") @db.Timestamptz(6)
  leaseToken  String?   @map("lease_token") @db.Uuid
  fetchedAt   DateTime? @map("fetched_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([state, availableAt])
  @@map("link_metadata")
}

model CaptureReceipt {
  userId       String   @map("user_id") @db.Uuid
  operationId  String   @map("operation_id") @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  fingerprint  String   @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([userId, operationId])
  @@map("capture_receipts")
}

// Discussion on one collection: top-level comments with one level of replies.
// Access follows the collection policy; moderation is owner/contributor hiding and,
// for the author, edit/delete. A deleted comment with replies keeps its place.
model CollectionComment {
  id             String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  collectionId   String    @map("collection_id") @db.Uuid
  authorUserId   String?   @map("author_user_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  body           String
  state          String    @default("visible") @db.VarChar(16)
  accepted       Boolean   @default(false)
  hiddenByUserId String?   @map("hidden_by_user_id") @db.Uuid
  version        BigInt    @default(1)
  editedAt       DateTime? @map("edited_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  collection Collection          @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  author     User?               @relation("CommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  hiddenBy   User?               @relation("CommentHider", fields: [hiddenByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  parent     CollectionComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  replies    CollectionComment[] @relation("CommentReplies")

  @@index([collectionId, createdAt(sort: Desc)], map: "idx_collection_comments_collection_created")
  @@index([parentId, createdAt], map: "idx_collection_comments_parent_created")
  @@map("collection_comments")
}

// References survive target deletion; content access remains scoped by immutable hubId.
// One evidence store. Category governs visibility and retention, never a separate log.
model AuditLog {
  id            String   @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  category      String   @default("content") @db.VarChar(16)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actorKind     String   @default("user") @map("actor_kind") @db.VarChar(16)
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  authority     String?  @db.VarChar(128)
  hubId         String?  @map("hub_id") @db.Uuid
  targetUserId  String?  @map("target_user_id") @db.Uuid
  collectionId  String?  @map("collection_id") @db.Uuid
  resourceId    String?  @map("resource_id") @db.Uuid
  invitationId  String?  @map("invitation_id") @db.Uuid
  action        String   @db.VarChar(48)
  role          String?  @db.VarChar(16)
  reason        String?  @db.VarChar(32)
  outcome       String?  @db.VarChar(16)
  beforeState   String?  @map("before_state") @db.VarChar(48)
  afterState    String?  @map("after_state") @db.VarChar(48)
  requestId     String?  @map("request_id") @db.VarChar(64)
  operationId   String?  @map("operation_id") @db.Uuid
  payloadHash   String?  @map("payload_hash") @db.VarChar(64)
  resultVersion Int?     @map("result_version")

  @@unique([actorUserId, operationId])
  @@unique([authority, operationId])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([hubId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([collectionId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([category, createdAt])
  @@map("audit_logs")
}

// Personal sharing history, separate from collection access grants. Resource
// references survive deletion; resolution always checks current visibility.
model ShareEntry {
  id              String   @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  kind            String   @db.VarChar(16)
  resourceId      String?  @map("resource_id") @db.Uuid
  message         String   @db.VarChar(1000)
  context         Json?    @db.JsonB
  operationId     String? @map("operation_id") @db.Uuid
  payloadHash     String? @map("payload_hash") @db.VarChar(64)
  openCount       Int      @default(0) @map("open_count")
  opens           ShareOpen[]
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  creator User @relation(fields: [createdByUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([createdByUserId, operationId])
  @@index([createdByUserId, id(sort: Desc)])
  @@index([kind, resourceId, createdAt])
  @@index([createdAt])
  @@map("share_entries")
}

// Idempotent client reports, without IPs, user agents, or recipient identities.
model ShareOpen {
  id        String   @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  shareId   String   @map("share_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  attribution Json? @db.JsonB
  context Json? @db.JsonB
  occurredAt DateTime? @map("occurred_at") @db.Timestamptz(6)
  payloadHash String? @map("payload_hash") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  share ShareEntry @relation(fields: [shareId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([shareId, eventId])
  @@index([shareId, createdAt])
  @@map("share_opens")
}

// Reservations outlive hub/account deletion. hubId is provenance, not a live FK.
model HubHandleReservation {
  id String @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  handle String @unique @db.VarChar(60)
  hubId String @map("hub_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("hub_handle_reservations")
}
