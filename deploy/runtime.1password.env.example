# Optional adapter input, not an application dependency. Replace reference IDs.
# Compose these fields with app-owned values from the selected native Environment:
# op run --environment ENVIRONMENT_ID --env-file=private-integrations.env -- COMMAND
# Keep these keys out of that Environment to avoid duplicate sources of truth.
GOOGLE_CLIENT_ID=op://VAULT_ID/GOOGLE_ITEM_ID/client_id
GOOGLE_CLIENT_SECRET=op://VAULT_ID/GOOGLE_ITEM_ID/client_secret
RESEND_API_KEY=op://VAULT_ID/RESEND_ITEM_ID/credential
